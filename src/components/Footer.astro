<script>
    const footer = document.getElementById('interactive-footer');
    const backLogo = document.getElementById('back-light-logo');

    if (footer && backLogo) {
        const animatedBackLogo = backLogo;

        let targetBackX = 0;
        let targetBackY = 0;
        let currentBackX = 0;
        let currentBackY = 0;

        footer.addEventListener('mousemove', (e) => {
            const rect = footer.getBoundingClientRect();

            const mouseX = ((e.clientX - rect.left) / rect.width) * 2 - 1;
            const mouseY = ((e.clientY - rect.top) / rect.height) * 2 - 1;

            targetBackX = mouseX * 7;
            targetBackY = mouseY * 5;
        });

        footer.addEventListener('mouseleave', () => {
            targetBackX = 0;
            targetBackY = 0;
        });

        function animate() {
            currentBackX += (targetBackX - currentBackX) * 0.08;
            currentBackY += (targetBackY - currentBackY) * 0.08;

            animatedBackLogo.style.transform = `translate3d(${currentBackX}px, ${currentBackY}px, 0)`;

            requestAnimationFrame(animate);
        }

        animate();
    }
</script>