---
import leftImg from '../../assets/images/left-image.webp';
import ftrVid from '../../assets/videos/footer-vid.mp4';
---

<div class="grid grid-cols-1 grid-rows-2 md:grid-rows-1 md:grid-cols-2 h-screen w-full font-light text-white">

    <div class="relative w-full h-full min-h-0">

        <img src={leftImg.src} alt="Bundle and Save" class="absolute inset-0 w-full h-full object-cover">
        <div class="absolute inset-0 bg-linear-to-t from-black/80 via-black/10 to-transparent"></div>

        <div class="relative z-10 w-full h-full px-8 py-8 flex justify-between">
                     
                <p class="text-xl">
                    Bundle & Save
                </p>

                <p class="text-xl w-[45%]">
                    One lives on the sofa. One stays on the bed. One goes wherever you go. Build your set and the savings apply automatically at checkout: 15% on two, 20% on three or more. 
                </p>

        </div>
    </div>

    <div class="relative w-full h-full min-h-0 bg-black">

        <video autoplay loop muted playsinline class="absolute inset-0 w-full h-full object-cover">
            <source src={ftrVid} type="video/mp4">
        </video>

        <div class="absolute inset-0 bg-linear-to-b from-black/80 via-black/10 to-transparent"></div>

        <div class="relative z-10 w-full h-full px-8 py-8 grid justify-end">
                     
            <p>
                <a href="#" class="relative after:bg-white after:absolute after:h-px after:w-0 after:-bottom-0.5 after:left-0 hover:after:w-full after:transition-all after:duration-700 text-xl">Our Story</a>
            </p>

        </div>
    </div>
</div>