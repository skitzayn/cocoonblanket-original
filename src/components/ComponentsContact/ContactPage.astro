<div class="px-4 h-screen py-24">

    <div class="grid grid-cols-2">

        <div>
            <p class="text-7xl font-marcellus">CONTACT US</p>
        </div>

        <div class="flex flex-col gap-6">

            <div>
                <p>Have a question or need support?</p>
                <p>Send us a message and we’ll get back to you as soon as possible.</p>
            </div>

            <div class="flex flex-col gap-2">

                <form class="flex w-full border border-neutral-400">
                    <input type="text" placeholder="Name" class="bg-transparent px-6 py-4 text-sm text-black placeholder:text-neutral-500 outline-none" required>
                </form>

                <form class="flex w-full border border-neutral-400">
                    <input type="email" placeholder="Email Address" class="bg-transparent px-6 py-4 text-sm text-black placeholder:text-neutral-500 outline-none" required>
                </form>

                <form class="flex w-full border border-neutral-400">
                    <input type="tel" placeholder="Phone Number" class="bg-transparent px-6 py-4 text-sm text-black placeholder:text-neutral-500 outline-none" required>
                </form>

                <form class="flex w-full border border-neutral-400">
                    <input type="text" placeholder="Message" class="bg-transparent px-6 pt-4 pb-20 text-sm text-black placeholder:text-neutral-500 outline-none" required>
                </form>

                <button type="submit" class="bg-transparent py-4 text-sm text-neutral-900 border border-neutral-400 cursor-pointer hover:bg-[#141414] duration-300 hover:text-[#F0F0F0]">
                        Sign up
                </button>

            </div>

        </div>

    </div>

</div>